    {
      "id": "claim_f431ef6bd3cd4dd69578b555e29aea46",
      "statement": "Spotify's label:\"...\" search filter matches fuzzily, so the ReleasePoller verifies every candidate against the full album object (GET /albums/{id}) and only upserts albums whose real Spotify label exactly (case-insensitive, trimmed) equals the followed label's name; the stored label_spotify attribution is the album's real label, and the label_albums junction table is the authoritative album-to-label link independent of the denormalized albums.label_id.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Domain/LabelAlbum.cs#L3-L18",
          "version": "repo-lines-v1:sha256:13022f1de2a79ecf0d981a7c8976cf101c295d041da69d7e550a9cb157b09dbc:"
