    {
      "id": "claim_fb91e6f7fb904d0591b30c0b7f5070c7",
      "statement": "Release paging is 1-based: page/pageSize must be positive (400 otherwise, defaulting to page=1 and pageSize=20 when one is omitted), releases sort newest first with NULL release dates coalesced to DateOnly.MinValue so they sort last under descending order, and hasMore = page * pageSize < totalCount where totalCount is the count of label_albums links for the label; paging runs in the database with no Spotify calls per page.",
      "evidence": [
