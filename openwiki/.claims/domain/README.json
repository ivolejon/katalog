    {
      "id": "claim_5ddea22ab25c48fa8395d31801ab0f9b",
      "statement": "A positively verified real-label mismatch removes any existing label_albums link (self-heal), and that verified-mismatch path plus the rename-time audit are the only deletion paths for junction rows: unverifiable candidates are skipped and transient search misses never delete links. The junction insert re-reads the label's committed current name under a FOR KEY SHARE row lock in one atomic SQL statement, so a poll pass carrying a pre-rename snapshot cannot link an album whose real label no longer matches.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L242-L266",
          "version": "repo-lines-v1:sha256:03232210596645285b36e9db9428176b4e18960aa9f96059503dc1ff6588cde2:"
