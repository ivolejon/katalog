    {
      "id": "claim_a14fa6ee2667446cb5bf3a3aab299c04",
      "statement": "The label_albums junction table is the source of truth for which releases belong to a label: GetLabelReleases queries the junction (never the denormalized album.label_id), and a release is only listed under a label whose name exactly matches the album's verified real Spotify label.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Domain/Album.cs#L3-L18",
          "version": "repo-lines-v1:sha256:5f617f1a0d211c578d457ea23ceed7421e15127e1d92bd934811c069bd205b3b:"
