    {
      "id": "claim_0c746639f20947dcac17e4818a37179e",
      "statement": "The primary add-label flow in the web frontend is label search: the useLabelSearch composable performs a debounced GET /api/labels/search (empty queries reset without hitting the API, a request-sequence guard drops stale responses), and AddLabelDialog submits the picked label's name plus the unique Spotify artist ids collected from its albums (collectArtistIds) to POST /api/labels.",
      "evidence": [
