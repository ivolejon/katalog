    {
      "id": "claim_4ef36605348948199ba62f49e452cee9",
      "statement": "Release discovery is label-search polling, not a poller per linked artist: ReleasesPollingService (a MigrationAwareBackgroundService that idles until no EF migrations are pending) polls once at startup and then on a PeriodicTimer at Polling:Interval (6-24 h, default 12 h), and each cycle ReleasePoller runs Spotify's label:\"<name>\" album search filter for every followed label; a singleton PollCursor row (job name artist_new_releases, kept from the pre-label-search era) records the last successful run for crash-safe resumption.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/MigrationAwareBackgroundService.cs#L23-L30",
          "version": "repo-lines-v1:sha256:1e98eba0d53f39288ec1468e54009660b5b029f900a4b6d192d1b7652a46bf19:"
        },
        {
