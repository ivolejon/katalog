        }
      ]
    },
    {
      "id": "claim_b57ee7c50ae449aebf5fa0a4e1871540",
      "statement": "PollOnceAsync isolates per-label failures (one label's exception is logged and the loop continues) and advances the singleton PollCursor unconditionally after the loop (CursorValue = startedAt, Status = completed); crash-safety comes from idempotent upserts, and the cursor primary key JobName 'artist_new_releases' is kept from the earlier artist-discography design to avoid a cursor migration.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L40-L92",
          "version": "repo-lines-v1:sha256:f95c9dae7731cbf5ba62ab02c083c1e25848a582bedb72d7ced583b5a821d597:"
        }
      ]
    },
    {
      "id": "claim_c2601e3d4ad2483a9cc58f7cebee6cc5",
      "statement": "CreateLabel runs ReleasePoller.PollLabelAsync immediately after the create transaction commits, in its own async scope with a fresh DbContext, so releases appear right away and a polling failure cannot roll the new label back; PollLabelAsync likewise logs and swallows polling failures for the next scheduled cycle to retry.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Labels/CreateLabel.cs#L82-L90",
          "version": "repo-lines-v1:sha256:78803b97a1d185a2d55b43259fbae6eced110a0e8db7526407b57dd85e29c516:"
