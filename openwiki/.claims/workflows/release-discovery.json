    {
      "id": "claim_f705dec6b2a6456ea24c3cddc82692fb",
      "statement": "All Spotify catalog calls go through a custom Polly resilience pipeline in SpotifySetup (TotalTimeout 300 s, Retry with max 3 attempts/exponential backoff from 2 s with jitter honouring Retry-After on 429, CircuitBreaker 30 s, AttemptTimeout 15 s); the standard defaults are deliberately not used because their 30 s total timeout would guillotine long Retry-After waits, and user-driven cancellation is never retried.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Setup/SpotifySetup.cs#L45-L91",
          "version": "repo-lines-v1:sha256:8b1608f1ad3c794d439f95f9663e3a2587324911f6d7b8469a0d034d7f25501e:"
        }
      ]
