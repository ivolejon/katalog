          "version": "repo-lines-v1:sha256:bb381c04ea92610018eb219f281768b409ddded5c2f3d8478a634a9ff88a5a27:"
        }
      ]
    },
    {
      "id": "claim_578dc6d6fb594eed8f0c875d010ca637",
      "statement": "Because the label search filter matches fuzzily (e.g. 'Globuli' also returns 'Globulin' albums) and search items omit the label field, VerifyAndUpsertAlbumAsync issues one GET /albums/{id} per search candidate and only upserts albums whose real label exactly equals the followed label's name (case-insensitive, trimmed OrdinalIgnoreCase).",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L209-L245",
          "version": "repo-lines-v1:sha256:31b7d7a422005ac1e0fe23e6ad3643324fed7848419e4de1c2f6f30b33c9a909:"
        },
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Infrastructure/Spotify/SpotifyApiClient.cs#L57-L65",
          "version": "repo-lines-v1:sha256:096285b2c6bc2d7ec931cd8da53c89e7241d91d62695a65dbaf06608fe800af2:"
        }
      ]
    },
    {
      "id": "claim_a69345a00a584fb88e05f2d8f89a5734",
      "statement": "ExtractRealLabel takes the trimmed top-level label field when present, otherwise falls back to parsing the copyrights array with CopyrightLabelRegex, which strips an optional ©/℗/(C)/(P)/C/P prefix, a leading 4-digit year, and trailing 'under'/'a division of' legal text; a candidate with no usable label from either source is unverifiable and skipped.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L500-L540",
          "version": "repo-lines-v1:sha256:099116a622a9f462fc78dc8e1376b31276377f91c6072cdb69cdbb6619ae6111:"
        }
      ]
    },
    {
      "id": "claim_d37d82aba04f4e229ef37ec7a1001be9",
      "statement": "RemoveVerifiedMismatchedLabelAlbumAsync is the only deletion path for label_albums rows and runs only after a positively verified real-label mismatch (or a 404 in the rename audit); candidates that cannot be verified or that search stops returning never cause deletions, which makes poll cycles self-healing for links written before exact verification existed.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L247-L293",
          "version": "repo-lines-v1:sha256:cc9b0a5668eddc4d427f6e510b7fdd671ae0fc8a9ad0d4f16890e4a1aa1601de:"
        }
      ]
    },
    {
      "id": "claim_8b8bad22821341c6bb66f4ecbec35e12",
      "statement": "UpsertAlbumAsync performs an idempotent INSERT ... ON CONFLICT (spotify_id) DO UPDATE on albums, storing label_spotify as the album's real verified Spotify label (not the discovering label's name), then upserts artists and album_artists junction rows and removes album_artists rows for artists no longer on the album.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L324-L399",
          "version": "repo-lines-v1:sha256:bd08313143cdf8aab67d708459ebd8bfcf6508ec762bc9a5a00689bb43853d39:"
        }
      ]
    },
    {
      "id": "claim_f9fce32fcc9d45e4a734d0e24a12e797",
      "statement": "UpsertLabelAlbumAsync links an album to a label in one atomic SQL statement guarded by the label's committed current name re-read under FOR KEY SHARE (trim(lower(l.name)) = trim(lower(@spotifyLabel))), so a poll pass carrying a stale pre-rename snapshot affects zero rows and can never link or resurrect an album whose real label no longer matches the renamed label.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L438-L475",
          "version": "repo-lines-v1:sha256:64f7a414e13f03c5561d0765e72da30507a2be0d99e3d7bd0c491a2614485094:"
        }
      ]
    },
    {
      "id": "claim_d805175fbed441fcb83fe25d06aa9145",
      "statement": "ReleasesPollingService polls once directly at start and then on every PeriodicTimer tick at PollingOptions.Interval (validated to 6-24 h, default 12 h), running each cycle in its own DI scope and logging-and-swallowing cycle failures so the host keeps running.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasesPollingService.cs#L7-L47",
          "version": "repo-lines-v1:sha256:2b0433c3dada153072aa427f989bd6549a54630cd5b81ab468a2182b571e23ab:"
