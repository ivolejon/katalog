  "claims": [
    {
      "id": "claim_d7fbb37694ba4796afc0711b07558ae0",
      "statement": "Release discovery searches Spotify with the fuzzy label:\"<name>\" album filter via SearchAlbumsByLabelAsync, clamping the per-request limit to Spotify's max of 10 and paging through the full result set (maxItems: null) by following validated same-origin next URLs, so labels with more than 10 releases are not silently capped.",
      "evidence": [
        {
          "resource": "repo://apps/katalog-api/src/Katalog.Api/Features/Releases/Polling/ReleasePoller.cs#L45-L50",
          "version": "repo-lines-v1:sha256:91a9af303caa2b98a679d6a542dd53184cce9673c1a9b5ae87176a9d297d531c:"
        },
        {
